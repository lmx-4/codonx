def square_all(xs: list[int]) -> list[int]:
    out: list[int] = [0 for _ in range(len(xs))]
    #%ifpy
    for i in range(len(xs)):
        out[i] = xs[i] * xs[i]
    #%else
    @par(schedule="dynamic", chunk_size=64)
    for i in range(len(xs)):
        out[i] = xs[i] * xs[i]
    #%endif
    return out

print(square_all([1, 2, 3]))
